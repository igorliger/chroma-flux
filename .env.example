# ---------------------------------------------------------------------------
# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto
# Supabase: painel do projeto > Connect (ou Project Settings > API).
#
# `.env.local` está no .gitignore e NUNCA deve ser versionado.
# ---------------------------------------------------------------------------

# Project URL
NEXT_PUBLIC_SUPABASE_URL=COLE_A_URL_AQUI

# Publishable key (começa com `sb_publishable_`).
# É pública por design: quem protege os dados é a Row Level Security, não o
# sigilo da chave. Em projetos antigos, o nome no painel é "anon public" — nesse
# caso a variável NEXT_PUBLIC_SUPABASE_ANON_KEY também é aceita.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_A_CHAVE_AQUI

# URL base da aplicação, usada nos links de confirmação de e-mail.
# Local: http://localhost:3000 | Vercel: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# NUNCA coloque aqui (nem em lugar nenhum do repositório):
#   - a senha do banco de dados
#   - a secret key (`sb_secret_...`, antiga `service_role`)
#
# Esta aplicação não usa a secret key em parte alguma — nem no servidor. Toda
# consulta roda com o JWT do usuário, sob RLS. Se uma chave dessas vazar para o
# GitHub, ela ignora todas as policies e dá acesso total ao banco; revogue-a
# imediatamente no painel do Supabase.
# ---------------------------------------------------------------------------
